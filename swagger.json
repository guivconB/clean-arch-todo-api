{
  "openapi": "3.0.0",
  "info": {
    "title": "Clean Architecture To-Do API",
    "version": "1.0.0",
    "description": "API de gerenciamento de tarefas construída com Clean Architecture"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    }
  ],
  "paths": {
    "/tasks": {
      "get": {
        "summary": "Lista todas as tarefas",
        "tags": ["Tasks"],
        "responses": {
          "200": {
            "description": "Lista de tarefas retornada com sucesso"
          }
        }
      },
      "post": {
        "summary": "Cria uma nova tarefa",
        "tags": ["Tasks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Aprender Swagger"
                  },
                  "description": {
                    "type": "string",
                    "example": "Documentar a API usando Swagger UI"
                  }
                },
                "required": ["title"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tarefa criada com sucesso"
          },
          "400": {
            "description": "Erro de validação (ex: título vazio)"
          }
        }
      }
    },
    "/tasks/{id}/complete": {
      "patch": {
        "summary": "Marca uma tarefa como concluída",
        "tags": ["Tasks"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "ID da tarefa"
          }
        ],
        "responses": {
          "200": {
            "description": "Tarefa atualizada com sucesso"
          },
          "400": {
            "description": "Tarefa não encontrada"
          }
        }
      }
    }
  }
}
